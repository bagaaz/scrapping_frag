DB_HOST=localhost
DB_PORT=3306
DB_NAME=fragrantica_db
DB_USER=root
DB_PASSWORD=

# Workers
WORKER_COUNT=10
REQUEST_TIMEOUT=30

# Proxy file (um proxy por linha: ip:porta:user:pass ou ip:porta)
PROXY_FILE=proxies.txt

# Rate limit por proxy (segundos entre requests do mesmo proxy)
PROXY_COOLDOWN=1.0

# Max retries por URL
MAX_RETRIES=3
